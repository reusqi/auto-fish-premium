{
	"schemaVersion": 1,
	"id": "autofish",
	"version": "${version}",
	"name": "Auto Fish Premium",
	"description": "A premium client-side utility featuring acoustic splash detection, a humanized recast scheduler, emergency durability protection, and automated hotbar food consumption.",
	"authors": [
		"Reusqi"
	],
	"contact": {
		"homepage": "https://modrinth.com/user/Reusqi",
		"sources": "https://modrinth.com/user/Reusqi"
	},
	"license": "MIT",
	"icon": "assets/autofish/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"com.adith.autofish.AutoFishPremium"
		],
		"client": [
			"com.adith.autofish.client.AutoFishPremiumClient"
		]
	},
	"mixins": [
		"autofish.mixins.json",
		{
			"config": "autofish.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}